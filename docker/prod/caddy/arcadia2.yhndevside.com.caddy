# Arcadia's staging host, while its data moves. Copy to /srv/platform/caddy/sites/ on the server,
# then reload Caddy. Add the DNS record first, so the first certificate attempt does not fail and
# back off. At cutover it becomes arcadia.yhndevside.com, without the noindex header.
arcadia2.yhndevside.com {
	encode zstd gzip

	# Staging is never indexed.
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy arcadia-web:80
}
