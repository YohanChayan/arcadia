# The production stack's .env, for compose.prod.yml. Copy to the repository root on the server
# as `.env`, fill the blanks, `chmod 600 .env`. Read by compose (`env_file`), not by Laravel's
# dotenv: write every value literally — no ${OTHER_VAR} references.
#
# Shown for production. A staging host differs in APP_URL, GOOGLE_REDIRECT_URI and a sandbox
# mailbox.

APP_NAME=Arcadia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://arcadia.yhndevside.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

ARCADIA_CONTACT_EMAIL=yhndevside@gmail.com
ARCADIA_DEVICE_LIMIT=3
PASSKEYS_ENABLED=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

# The platform MySQL, over the external `db` network. Its container name, not the shared
# `mysql` alias, which another stack could also claim.
DB_CONNECTION=mysql
DB_HOST=platform-mysql-1
DB_PORT=3306
DB_DATABASE=arcadia
DB_USERNAME=arcadia
DB_PASSWORD=

# Database-backed, so arc-app and arc-queue — separate containers — share them.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# The real mailbox: guide requests and access requests reach the owner from here.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yhndevside.com"
MAIL_FROM_NAME=Arcadia
MAIL_BUSINESS_ADDRESS=yhndevside@gmail.com

# The studio's Google OAuth client, which lists this callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://arcadia.yhndevside.com/auth/google/callback

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://arc-ssr:13714
